{
  "name": "side-quests",
  "private": true,
  "workspaces": [
    "packages/*",
    "server",
    "app"
  ],
  "scripts": {
    "test": "npm run test -w @side-quests/game",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "server": "npm run dev -w server",
    "app": "npm run start -w app",
    "web:build": "cd app && npx expo export --platform web",
    "party": "node scripts/party.mjs",
    "party:local": "node scripts/party.mjs --local",
    "deploy": "npm run web:build && npm run deploy -w server",
    "qr": "node scripts/show-qr.mjs"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261019.1": true,
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  },
  "devDependencies": {
    "qrcode": "^1.5.4",
    "typescript": "~6.0.3"
  }
}
