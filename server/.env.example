# Copy to .env for local development (wrangler dev reads it). Never commit .env.
# With a key, AI quests come from OpenAI; without one, the offline deck fills in.
OPENAI_API_KEY=sk-...
# Optional: which model writes quests (default gpt-5.4-mini).
# OPENAI_MODEL=gpt-5.4-mini

# Optional: without these, the standalone cross-city demo (/demo-cities.html) falls
# back to its saved example snapshot. Unused by the real game.
# OPENTRIPMAP_API_KEY=...
# TICKETMASTER_API_KEY=...
